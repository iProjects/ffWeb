@model fPeerLending.Entities.Member
@{
    ViewBag.Title = "Edit Profile - Fanikiwa";
    var defaultDate = new DateTime(1, 1, 1);
    var formattedDob = (Model.DateOfBirth == defaultDate || Model.DateOfBirth == DateTime.MinValue)
        ? DateTime.Now.ToString("yyyy-MM-dd")
        : Model.DateOfBirth.ToString("yyyy-MM-dd");

    List<SelectListItem> genderOptions = new List<SelectListItem>
    {
        new SelectListItem { Text = "Male", Value = "M" },
        new SelectListItem { Text = "Female", Value = "F" }
    };

    List<SelectListItem> informOptions = new List<SelectListItem>
    {
        new SelectListItem { Text = "SMS Notification", Value = "SMS" },
        new SelectListItem { Text = "Email Notification", Value = "EMAIL" }
    };
}

<link rel="stylesheet" href="~/Content/edit_profile.css" />

<!-- Embedded SVG Sprite Definition Sheet -->
<svg xmlns="http://www.w3.org/2000/svg" class="d-none">
    <symbol id="icon-user" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
    </symbol>
    <symbol id="icon-camera" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
        <circle cx="12" cy="13" r="4"></circle>
    </symbol>
    <symbol id="icon-wallet" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <line x1="2" y1="10" x2="22" y2="10"></line>
    </symbol>
    <symbol id="icon-group" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M7 23v-2a4 4 0 0 1 3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        <circle cx="9" cy="7" r="4"></circle>
    </symbol>
    <symbol id="icon-award" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="8" r="7"></circle>
        <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
    </symbol>
    <symbol id="icon-key" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 2l-2 2m-1.5 1.5l-3 3m-2 2l-3 3 1.5 1.5M3 21v-3l9-9"></path>
        <circle cx="7.5" cy="16.5" r="1.5"></circle>
    </symbol>
    <symbol id="icon-cash-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="1" x2="12" y2="23"></line>
        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
    </symbol>
    <symbol id="icon-user-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="8.5" cy="7" r="4"></circle>
        <line x1="18" y1="8" x2="23" y2="13"></line>
        <line x1="23" y1="8" x2="18" y2="13"></line>
    </symbol>
</svg>
<div class="profile-dashboard container-fluid py-3 px-3 px-md-5">

    <!-- Top Action Navigation Pills -->
    <div class="quick-nav-wrapper mb-4">
        <div class="quick-nav-container pb-2">
            @using (Html.BeginForm("MyAccounts", "Account", FormMethod.Get, new { id = "my-accounts-profile-form" }))
            {
                <button type="button" class="btn btn-nav-pill btn-submit-form" data-form="my-accounts-profile-form">
                    <svg class="svg-icon me-2"><use href="#icon-wallet"></use></svg> My Accounts
                </button>
            }
            @using (Html.BeginForm("GetAllMailingGroups", "Offers", FormMethod.Get, new { id = "my-offer-groups-profile-form" }))
            {
                <button type="button" class="btn btn-nav-pill btn-submit-form" data-form="my-offer-groups-profile-form">
                    <svg class="svg-icon me-2"><use href="#icon-group"></use></svg> Offer Groups
                </button>
            }
            @using (Html.BeginForm("Scores", "Account", FormMethod.Get, new { id = "offer-scores-profile-form" }))
            {
                <button type="button" class="btn btn-nav-pill btn-submit-form" data-form="offer-scores-profile-form">
                    <svg class="svg-icon me-2"><use href="#icon-award"></use></svg> Offer Scores
                </button>
            }
            @using (Html.BeginForm("WithDrawCash", "WithDraw", FormMethod.Get, new { id = "withdraw-profile-form" }))
            {
                <button type="button" class="btn btn-nav-pill btn-submit-form" data-form="withdraw-profile-form">
                    <svg class="svg-icon me-2"><use href="#icon-cash-out"></use></svg> Withdraw
                </button>
            }
            @using (Html.BeginForm("Manage", "Account", FormMethod.Get, new { id = "change-password-profile-form" }))
            {
                <button type="button" class="btn btn-nav-pill btn-submit-form" data-form="change-password-profile-form">
                    <svg class="svg-icon me-2"><use href="#icon-key"></use></svg> Password
                </button>
            }
            @using (Html.BeginForm("DeRegister", "Account", FormMethod.Get, new { id = "de-register-profile-form" }))
            {
                <button type="button" class="btn btn-nav-pill text-danger border-danger-subtle btn-submit-form" data-form="de-register-profile-form">
                    <svg class="svg-icon me-2"><use href="#icon-user-x"></use></svg> DeRegister
                </button>
            }
        </div>
    </div>

    <!-- Main Profile Settings Container -->
    <div class="row g-4 justify-content-center">
        <!-- Avatar & Summary Sidebar Card -->
        <div class="col-12 col-lg-4 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100">
                <div class="profile-avatar-wrapper position-relative mx-auto mb-3">
                    <img src="@(string.IsNullOrEmpty(Model.Photo) ? Url.Content("~/Images/defaultphoto.jpg") : Url.Content("~/Images/" + Model.Photo))"
                         alt="Member Profile Picture" class="avatar-image rounded-circle img-thumbnail shadow-sm" />

                    @if (Model.Photo != null)
                    {
                        using (Html.BeginForm("UploadMemberImage_Edit", "Account", new { id = Model.MemberId }, FormMethod.Get, new { id = "change-photo-form" }))
                        {
                            <button type="button" class="avatar-upload-btn btn btn-primary rounded-circle p-2 border-3 border-white btn-submit-form" data-form="change-photo-form" title="Change Avatar">
                                <svg class="svg-icon svg-icon-sm"><use href="#icon-camera"></use></svg>
                            </button>
                        }
                    }
                    else
                    {
                        using (Html.BeginForm("UploadMemberImage_Edit", "Account", new { id = Model.MemberId }, FormMethod.Post, new { id = "upload-photo-form" }))
                        {
                            <button type="button" class="avatar-upload-btn btn btn-primary rounded-circle p-2 border-3 border-white btn-submit-form" data-form="upload-photo-form" title="Upload Avatar">
                                <svg class="svg-icon svg-icon-sm"><use href="#icon-camera"></use></svg>
                            </button>
                        }
                    }
                </div>
                <h5 class="fw-bold mb-1">@Model.Surname @Model.OtherNames</h5>
                <p class="text-muted small mb-3">@Model.Email</p>
                <div class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mx-auto">
                    Member ID: #@Model.MemberId
                </div>
            </div>
        </div>
        <!-- Form Details Main Card -->
        <div class="col-12 col-lg-8 col-xl-9">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="d-flex align-items-center mb-4">
                    <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3 me-3">
                        <svg class="svg-icon svg-icon-md"><use href="#icon-user"></use></svg>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Personal Settings</h4>
                        <p class="text-muted small mb-0">Update your details and communication preferences</p>
                    </div>
                </div>
                @using (Html.BeginForm("EditProfile", "Account", FormMethod.Post, new { enctype = "multipart/form-data", id = "edit-profile-form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                    @Html.HiddenFor(model => model.MemberId)
                    @Html.HiddenFor(model => model.Email)

                    <!-- Form Controls Grid -->
                    <div class="row g-3">
                        <!-- Surname -->
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                @Html.TextBoxFor(model => model.Surname, new { @class = "form-control rounded-3", placeholder = "Surname", autofocus = "autofocus" })
                                @Html.LabelFor(model => model.Surname)
                            </div>
                            @Html.ValidationMessageFor(model => model.Surname, "", new { @class = "text-danger small" })
                        </div>
                        <!-- Other Names -->
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                @Html.TextBoxFor(model => model.OtherNames, new { @class = "form-control rounded-3", placeholder = "Other Names" })
                                @Html.LabelFor(model => model.OtherNames)
                            </div>
                            @Html.ValidationMessageFor(model => model.OtherNames, "", new { @class = "text-danger small" })
                        </div>
                        <!-- Date of Birth -->
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                @Html.TextBoxFor(model => model.DateOfBirth, new { Value = formattedDob, @class = "form-control rounded-3", type = "date" })
                                @Html.LabelFor(model => model.DateOfBirth)
                            </div>
                            @Html.ValidationMessageFor(model => model.DateOfBirth, "", new { @class = "text-danger small" })
                        </div>
                        <!-- Gender -->
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                @Html.DropDownListFor(model => model.Gender, genderOptions, "-- Select Gender --", new { @class = "form-select rounded-3", id = "cboGender" })
                                @Html.LabelFor(model => model.Gender)
                            </div>
                            @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger small" })
                        </div>
                        <!-- Telephone -->
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                @Html.TextBoxFor(m => m.Telephone, new { @class = "form-control rounded-3", type = "tel", placeholder = "254717769329" })
                                @Html.LabelFor(model => model.Telephone)
                            </div>
                            @Html.ValidationMessageFor(model => model.Telephone, "", new { @class = "text-danger small" })
                        </div>
                        <!-- Inform By -->
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                @Html.DropDownListFor(model => model.InformBy, informOptions, "-- Select Inform By --", new { @class = "form-select rounded-3", id = "cboInformBy" })
                                @Html.LabelFor(model => model.InformBy)
                            </div>
                            @Html.ValidationMessageFor(model => model.InformBy, "", new { @class = "text-danger small" })
                        </div>
                        <!-- National ID -->
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                @Html.TextBoxFor(model => model.NationalID, new { @class = "form-control rounded-3", placeholder = "National ID" })
                                @Html.LabelFor(model => model.NationalID)
                            </div>
                            @Html.ValidationMessageFor(model => model.NationalID, "", new { @class = "text-danger small" })
                        </div>
                        <!-- Referred By -->
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                @Html.TextBoxFor(model => model.RefferedBy, new { @class = "form-control rounded-3", placeholder = "Referred By" })
                                @Html.LabelFor(model => model.RefferedBy)
                            </div>
                            @Html.ValidationMessageFor(model => model.RefferedBy, "", new { @class = "text-danger small" })
                        </div>
                        <!-- Max Records Displayed -->
                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                @Html.TextBoxFor(model => model.MaxRecordsToDisplay, new { @class = "form-control rounded-3", type = "number", min = "0", placeholder = "10" })
                                @Html.LabelFor(model => model.MaxRecordsToDisplay)
                            </div>
                            @Html.ValidationMessageFor(model => model.MaxRecordsToDisplay, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <!-- Submit Actions -->
                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold btn-submit-form" data-form="edit-profile-form">
                            Save Changes
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- Global Loading Overlay -->
<div id="progress" class="dashboard-progress-overlay d-none">
    <div class="spinner-border text-light" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/edit_profile.js"></script>
}
