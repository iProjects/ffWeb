@model IEnumerable<fPeerLending.Entities.Offer>
@using ffWeb.UI.MVC.Helpers
@{
    ViewBag.Title = "My Offers";
    int offersCount = Model.Count();
}

<link href="~/Content/my_offers.css" rel="stylesheet" type="text/css" />

<!-- Main Container with Fixed Header Padding Top -->
<main class="main-content container-fluid container-xl">

    <!-- Hero / Page Title Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark m-0">My Offers</h1>
            <p class="text-muted small m-0">Manage and track your active peer lending & borrowing offers</p>
        </div>
        <span class="badge rounded-pill text-bg-primary px-3 py-2 fs-6">
            Total Offers: <span id="offer-count">@offersCount</span>
        </span>
    </div>
    <!-- Quick Action Cards Section -->
    <div class="row g-3 mb-4">
        <!-- Lend Money Form -->
        <div class="col-12 col-md-4">
            @using (Html.BeginForm("CreateLendOffer", "Offers", FormMethod.Get, new { enctype = "multipart/form-data", id = "create-lend-offer-form" }))
            {
                <button type="button" class="action-card btn-action-submit w-100 p-3 text-start border-0 rounded-3 shadow-sm h-100" data-form-id="create-lend-offer-form">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-wrapper bg-success-subtle text-success rounded-circle p-3">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <polyline points="19 12 12 19 5 12"></polyline>
                            </svg>
                        </div>
                        <div>
                            <span class="d-block fw-bold text-dark mb-1">Lend Money</span>
                            <small class="text-muted d-block">I want to lend money to somebody</small>
                        </div>
                    </div>
                </button>
            }
        </div>
        <!-- Borrow Money Form -->
        <div class="col-12 col-md-4">
            @using (Html.BeginForm("CreateBorrowOffer", "Offers", FormMethod.Get, new { enctype = "multipart/form-data", id = "create-borrow-offer-form" }))
            {
                <button type="button" class="action-card btn-action-submit w-100 p-3 text-start border-0 rounded-3 shadow-sm h-100" data-form-id="create-borrow-offer-form">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-wrapper bg-primary-subtle text-primary rounded-circle p-3">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="19" x2="12" y2="5"></line>
                                <polyline points="5 12 12 5 19 12"></polyline>
                            </svg>
                        </div>
                        <div>
                            <span class="d-block fw-bold text-dark mb-1">Borrow Money</span>
                            <small class="text-muted d-block">I want to borrow some money</small>
                        </div>
                    </div>
                </button>
            }
        </div>
        <!-- General Offer Form -->
        <div class="col-12 col-md-4">
            @using (Html.BeginForm("Create", "Offers", FormMethod.Get, new { enctype = "multipart/form-data", id = "create-offer-form" }))
            {
                <button type="button" class="action-card btn-action-submit w-100 p-3 text-start border-0 rounded-3 shadow-sm h-100" data-form-id="create-offer-form">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-wrapper bg-warning-subtle text-warning-emphasis rounded-circle p-3">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="16"></line>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                        </div>
                        <div>
                            <span class="d-block fw-bold text-dark mb-1">Create Offer</span>
                            <small class="text-muted d-block">I want to create a custom offer</small>
                        </div>
                    </div>
                </button>
            }
        </div>
    </div>
    <!-- Offers Data List / Card View -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">

            <!-- Mobile View: Modern Cards (Visible on screens smaller than Desktop MD) -->
            <div class="d-block d-lg-none p-3">
                @foreach (var item in Model)
                {
                    <div class="offer-mobile-card mb-3 p-3 rounded-3 border bg-white shadow-xs">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="fw-bold text-dark h6 mb-0">@Html.DisplayFor(modelItem => item.Description)</span>
                            <span class="badge @(item.PublicOffer.Equals("B") ? "bg-info-subtle text-info-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                @(item.PublicOffer.Equals("B") ? "Public" : "Private")
                            </span>
                        </div>
                        <div class="row g-2 text-muted small mb-3">
                            <div class="col-6">
                                <span class="d-block text-uppercase text-xs fw-semibold">Amount</span>
                                <span class="fw-bold text-dark fs-6">$@string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:N2}", item.Amount)</span>
                            </div>
                            <div class="col-3">
                                <span class="d-block text-uppercase text-xs fw-semibold">Term</span>
                                <span class="text-dark">@Html.DisplayFor(modelItem => item.Term)</span>
                            </div>
                            <div class="col-3">
                                <span class="d-block text-uppercase text-xs fw-semibold">Status</span>
                                <span class="text-dark">@Html.DisplayFor(modelItem => item.Status)</span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 border-top pt-2">
                            <a href="@Url.Action("Details", "Offers", new { id = item.Id })" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg> Details
                            </a>
                            <a href="@Url.Action("Edit", "Offers", new { id = item.Id })" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg> Edit
                            </a>
                            <a href="@Url.Action("Delete", "Offers", new { id = item.Id, description = item.Description })" data-modal="" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg> Delete
                            </a>
                        </div>
                    </div>
                }
            </div>
            <!-- Desktop View: Modern Responsive Table (Visible on LG screens and up) -->
            <div class="table-responsive d-none d-lg-block">
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.Description)</th>
                            <th>@Html.DisplayNameFor(model => model.Amount)</th>
                            <th>@Html.DisplayNameFor(model => model.Term)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>@Html.DisplayNameFor(model => model.PublicOffer)</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">
                                    @Html.DisplayFor(modelItem => item.Description)
                                </td>
                                <td class="fw-bold text-dark">
                                    $@string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:N2}", item.Amount)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Term)
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-light text-dark border">
                                        @Html.DisplayFor(modelItem => item.Status)
                                    </span>
                                </td>
                                <td>
                                    @if (item.PublicOffer.Equals("B"))
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis">Public</span>
                                    }
                                    @if (item.PublicOffer.Equals("V"))
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">Private</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="@Url.Action("Edit", "Offers", new { id = item.Id })" class="btn btn-light border" title="Edit">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                        </a>
                                        <a href="@Url.Action("Details", "Offers", new { id = item.Id })" class="btn btn-light border" title="Details">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
                                        </a>
                                        <a href="@Url.Action("Delete", "Offers", new { id = item.Id, description = item.Description })" data-modal="" class="btn btn-light border text-danger" title="Delete">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>
<!-- Modern Fullscreen Loading Overlay -->
<div id="progress" class="loading-overlay displaynone" style="display: none;">
    <div class="spinner-wrapper">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 fw-medium text-dark">Processing request...</p>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/my_offers.js"></script>
}
