@*Here is the redesigned "Get A Loan / Offers Made to Me" view. It transforms the legacy raw table into a mobile-first, fintech-style interface using Bootstrap 5, embedded SVGs, separate CSS/JS, and responsive media queries with dynamic fixed-header offset compensation.
1. Razor View (GetALoan.cshtml)*@
@model IEnumerable<fPeerLending.Entities.Offer>
@using fPeerLending.Business;
@{
    ViewBag.Title = "Get A Loan";
    int offersCount = Model.Count();
}
 
<link href="~/Content/my_lend_offers.css" rel="stylesheet" type="text/css" />

<!-- Main Container (Offset for Fixed Header) -->
<main class="main-content container-fluid container-xl">
    <!-- Page Title & Header Actions -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark m-0">Offers Made to Me</h1>
            <p class="text-muted small m-0">Review loan offers extended to you or request new funding</p>
        </div>
        <span class="badge rounded-pill text-bg-primary px-3 py-2 fs-6">
            Offers Available: <span id="offer-count">@offersCount</span>
        </span>
    </div>
    <!-- Quick Action Card -->
    <div class="row mb-4">
        <div class="col-12 col-md-6 col-lg-4">
            @using (Html.BeginForm("CreateBorrowOffer", "Offers", FormMethod.Get, new { enctype = "multipart/form-data", id = "create-offer-form" }))
            {
                <button type="button" class="action-card btn-action-submit w-100 p-3 text-start border-0 rounded-3 shadow-sm" data-form-id="create-offer-form">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-wrapper bg-primary-subtle text-primary rounded-circle p-3">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="16"></line>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                        </div>
                        <div>
                            <span class="d-block fw-bold text-dark mb-1">Borrow Money</span>
                            <small class="text-muted d-block">Request a new loan offer</small>
                        </div>
                    </div>
                </button>
            }
        </div>
    </div>
    <!-- Data Layout Container -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <!-- Mobile & Tablet View: Cards (< 992px) -->
            <div class="d-block d-lg-none p-3">
                @foreach (var item in Model)
                {
                    <div class="loan-card mb-3 p-3 rounded-3 border bg-white shadow-xs">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="d-block text-uppercase text-muted text-xs fw-semibold mb-1">Description</span>
                                <h6 class="fw-bold text-dark mb-0">@Html.DisplayFor(modelItem => item.Description)</h6>
                            </div>
                            <span class="badge @(item.PublicOffer.Equals("B") ? "bg-info-subtle text-info-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                @(item.PublicOffer.Equals("B") ? "Public" : "Private")
                            </span>
                        </div>
                        <div class="row g-2 py-2 my-2 border-top border-bottom text-muted small">
                            <div class="col-6">
                                <span class="d-block text-uppercase text-xs fw-semibold">Amount</span>
                                <span class="fw-bold text-dark fs-6">$@string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:N2}", item.Amount)</span>
                            </div>
                            <div class="col-3">
                                <span class="d-block text-uppercase text-xs fw-semibold">Term</span>
                                <span class="text-dark fw-medium">@Html.DisplayFor(modelItem => item.Term)</span>
                            </div>
                            <div class="col-3">
                                <span class="d-block text-uppercase text-xs fw-semibold">Status</span>
                                <span class="badge rounded-pill bg-light text-dark border">
                                    @Html.DisplayFor(modelItem => item.Status)
                                </span>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 pt-1">
                            @if (item.Status.Equals(OfferStatus.Open.ToString()))
                            {
                                <a href="@Url.Action("AcceptLendOffer", "Offers", new { id = item.Id })" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
                                    Accept
                                </a>
                            }
                            @if (item.PartialPay && item.Status.Equals(OfferStatus.Open.ToString()))
                            {
                                <a href="@Url.Action("AcceptPartialLendOffer", "Offers", new { id = item.Id })" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                                    Accept Partial
                                </a>
                            }
                            <a href="@Url.Action("Details", "Offers", new { id = item.Id })" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
                                Details
                            </a>
                        </div>
                    </div>
                }
            </div>
            <!-- Desktop View: Table (>= 992px) -->
            <div class="table-responsive d-none d-lg-block">
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.Description)</th>
                            <th>@Html.DisplayNameFor(model => model.Amount)</th>
                            <th>@Html.DisplayNameFor(model => model.Term)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>@Html.DisplayNameFor(model => model.PublicOffer)</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">
                                    @Html.DisplayFor(modelItem => item.Description)
                                </td>
                                <td class="fw-bold text-dark">
                                    $@string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:N2}", item.Amount)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Term)
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-light text-dark border">
                                        @Html.DisplayFor(modelItem => item.Status)
                                    </span>
                                </td>
                                <td>
                                    @if (item.PublicOffer.Equals("B"))
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis">Public</span>
                                    }
                                    @if (item.PublicOffer.Equals("V"))
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">Private</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1" role="group">
                                        @if (item.Status.Equals(OfferStatus.Open.ToString()))
                                        {
                                            <a href="@Url.Action("AcceptLendOffer", "Offers", new { id = item.Id })" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1" title="Accept Offer">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
                                                Accept
                                            </a>
                                        }
                                        @if (item.PartialPay && item.Status.Equals(OfferStatus.Open.ToString()))
                                        {
                                            <a href="@Url.Action("AcceptPartialLendOffer", "Offers", new { id = item.Id })" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1" title="Accept Partial Offer">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                                                Partial
                                            </a>
                                        }
                                        <a href="@Url.Action("Details", "Offers", new { id = item.Id })" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-1" title="Details">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
                                            Details
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>
<!-- Fullscreen Loading Overlay -->
<div id="progress" class="loading-overlay displaynone" style="display: none;">
    <div class="spinner-wrapper">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 fw-medium text-dark">Processing request...</p>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/my_lend_offers.js"></script>
}
