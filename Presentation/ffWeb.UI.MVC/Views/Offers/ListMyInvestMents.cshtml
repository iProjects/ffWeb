@*Here is a complete, modern redesign of your "My Investments" view. The design shifts away from a plain, data-entry table style toward a polished fintech dashboard. It features inline SVGs, Bootstrap 5 styling, mobile-first design, adaptive CSS media queries, and dynamic handling for fixed header heights.
1. Razor View (Index.cshtml / MyInvestments.cshtml)*@
@model IEnumerable<fPeerLending.Entities.Offer>
@{
    ViewBag.Title = "My Investments";
    int investmentCount = Model.Count();
}

<link href="~/Content/my_investments.css" rel="stylesheet" type="text/css" />

<!-- Main Dashboard Container with Fixed Header Padding Buffer -->
<main class="main-content container-fluid container-xl">
    <!-- Page Title & Header Stats -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark m-0">My Investments</h1>
            <p class="text-muted small m-0">Track and review your active peer lending investments</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill text-bg-primary px-3 py-2 fs-6">
                Active Items: <span id="investment-count">@investmentCount</span>
            </span>
        </div>
    </div>
    <!-- Data Layout Container -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <!-- Mobile & Tablet View: Responsive Cards (< 992px) -->
            <div class="d-block d-lg-none p-3">
                @foreach (var item in Model)
                {
                    <div class="investment-card mb-3 p-3 rounded-3 border bg-white shadow-xs">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span class="d-block text-uppercase text-muted text-xs fw-semibold mb-1">Description</span>
                                <h6 class="fw-bold text-dark mb-0">@Html.DisplayFor(modelItem => item.Description)</h6>
                            </div>
                            <span class="badge @(item.PublicOffer.Equals("B") ? "bg-info-subtle text-info-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                @(item.PublicOffer.Equals("B") ? "Public" : "Private")
                            </span>
                        </div>
                        <div class="row g-2 pt-2 border-top">
                            <div class="col-6">
                                <span class="d-block text-uppercase text-muted text-xs fw-semibold">Amount</span>
                                <span class="fw-bold text-success fs-6">
                                    $@string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:N2}", item.Amount)
                                </span>
                            </div>
                            <div class="col-3">
                                <span class="d-block text-uppercase text-muted text-xs fw-semibold">Term</span>
                                <span class="text-dark fw-medium">@Html.DisplayFor(modelItem => item.Term)</span>
                            </div>
                            <div class="col-3">
                                <span class="d-block text-uppercase text-muted text-xs fw-semibold">Status</span>
                                <span class="badge rounded-pill bg-light text-dark border">
                                    @Html.DisplayFor(modelItem => item.Status)
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <!-- Desktop View: Modern Data Table (>= 992px) -->
            <div class="table-responsive d-none d-lg-block">
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="ps-4">
                                <span class="d-inline-flex align-items-center gap-1">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                                    @Html.DisplayNameFor(model => model.Description)
                                </span>
                            </th>
                            <th>
                                <span class="d-inline-flex align-items-center gap-1">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                                    @Html.DisplayNameFor(model => model.Amount)
                                </span>
                            </th>
                            <th>
                                <span class="d-inline-flex align-items-center gap-1">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                                    @Html.DisplayNameFor(model => model.Term)
                                </span>
                            </th>
                            <th>
                                <span class="d-inline-flex align-items-center gap-1">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                                    @Html.DisplayNameFor(model => model.Status)
                                </span>
                            </th>
                            <th class="pe-4">
                                <span class="d-inline-flex align-items-center gap-1">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
                                    @Html.DisplayNameFor(model => model.PublicOffer)
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">
                                    @Html.DisplayFor(modelItem => item.Description)
                                </td>
                                <td class="fw-bold text-success">
                                    $@string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:N2}", item.Amount)
                                </td>
                                <td class="text-secondary fw-medium">
                                    @Html.DisplayFor(modelItem => item.Term)
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-light text-dark border px-2.5 py-1.5">
                                        @Html.DisplayFor(modelItem => item.Status)
                                    </span>
                                </td>
                                <td class="pe-4">
                                    @if (item.PublicOffer.Equals("B"))
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis">Public</span>
                                    }
                                    @if (item.PublicOffer.Equals("V"))
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">Private</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>
<!-- Modern Fullscreen Loading Overlay -->
<div id="progress" class="loading-overlay displaynone" style="display: none;">
    <div class="spinner-wrapper">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 fw-medium text-dark">Loading investments...</p>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/my_investments.js"></script>
}
